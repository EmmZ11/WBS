{
  "name": "restful-booker-platform-tests",
  "version": "1.0.0",
  "private": true,
  "description": "API and UI test framework for the Restful Booker Platform admin tool",
  "scripts": {
    "test": "playwright test",
    "test:platform-api": "playwright test --project=platform-api",
    "test:platform-ui": "playwright test --project=platform-ui",
    "test:booker-api": "playwright test --project=booker-api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
